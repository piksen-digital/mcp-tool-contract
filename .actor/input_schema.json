{
  "title": "MCP Tool-Contract Auditor Input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "targets": {
      "sectionCaption": "1. Targets",
      "title": "Targets",
      "type": "array",
      "description": "Add one or more MCP endpoints, OpenAPI specifications, or Apify Actors.",
      "editor": "json",
      "prefill": [
        {
          "type": "openapi",
          "url": "https://example.com/openapi.json",
          "name": "Example API"
        }
      ],
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "title": "Target type",
            "enum": [
              "mcp",
              "openapi",
              "apify-actor"
            ],
            "enumTitles": [
              "Remote MCP endpoint",
              "OpenAPI specification",
              "Apify Actor"
            ],
            "default": "openapi",
            "description": "The kind of target to audit: a remote MCP endpoint, an OpenAPI specification, or an Apify Actor."
          },
          "url": {
            "type": "string",
            "title": "URL",
            "description": "Full HTTP or HTTPS URL for an MCP or OpenAPI target.",
            "pattern": "^https?://\\S+$",
            "maxLength": 2048
          },
          "actorId": {
            "type": "string",
            "title": "Actor ID",
            "description": "An Actor ID or owner/name. Used for Apify Actor targets.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}(/[A-Za-z0-9][A-Za-z0-9_.-]{0,99})?$",
            "maxLength": 201
          },
          "name": {
            "type": "string",
            "title": "Display name",
            "description": "Optional label used in reports.",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": ["type"]
      },
      "maxItems": 50
    },
    "checks": {
      "sectionCaption": "2. Audit scope",
      "title": "Checks",
      "type": "array",
      "description": "Choose the compliance categories to run.",
      "editor": "select",
      "uniqueItems": true,
      "default": [
        "contracts",
        "agent-ready",
        "x402",
        "store",
        "security"
      ],
      "items": {
        "type": "string",
        "enum": [
          "contracts",
          "agent-ready",
          "x402",
          "store",
          "security"
        ],
        "enumTitles": [
          "Tool contracts",
          "Agent readiness",
          "x402 payments",
          "Store metadata",
          "Security"
        ]
      },
      "minItems": 1
    },
    "failOn": {
      "sectionCaption": "3. CI behavior",
      "title": "Fail run at severity",
      "type": "string",
      "description": "Return a non-zero exit code when findings reach this severity.",
      "editor": "select",
      "enum": [
        "none",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "enumTitles": [
        "Never fail",
        "Low or above",
        "Medium or above",
        "High or above",
        "Critical only"
      ],
      "default": "high"
    },
    "exportFormats": {
      "title": "Report formats",
      "type": "array",
      "description": "Additional report formats to write to the Key-Value Store. A machine-readable 'results.json' findings record is always written, regardless of this selection.",
      "editor": "select",
      "uniqueItems": true,
      "default": [
        "summary",
        "sarif",
        "junit"
      ],
      "items": {
        "type": "string",
        "enum": [
          "summary",
          "sarif",
          "junit"
        ]
      }
    },
    "requestTimeoutSecs": {
      "sectionCaption": "4. Network",
      "title": "Request timeout (seconds)",
      "type": "integer",
      "editor": "number",
      "minimum": 5,
      "maximum": 120,
      "default": 30,
      "description": "Maximum time to wait for each network request, in seconds."
    },
    "maxRedirects": {
      "title": "Maximum redirects",
      "type": "integer",
      "editor": "number",
      "minimum": 0,
      "maximum": 10,
      "default": 5,
      "description": "Maximum number of HTTP redirects to follow before failing the request."
    },
    "proxyConfiguration": {
      "title": "Proxy configuration",
      "type": "object",
      "description": "Leave disabled for direct connections.",
      "editor": "proxy"
    },
    "includePassingChecks": {
      "title": "Include passing checks",
      "type": "boolean",
      "description": "Include successful checks in the dataset and SUMMARY report.",
      "default": true
    },
    "dryRun": {
      "title": "Dry run",
      "type": "boolean",
      "description": "Validate targets without making network requests.",
      "default": false
    }
  },
  "required": [
    "targets"
  ],
  "additionalProperties": false
}
